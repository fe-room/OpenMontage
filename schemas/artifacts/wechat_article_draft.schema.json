{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/wechat_article_draft",
  "title": "WeChat Article Draft",
  "description": "Searchable, evidence-linked finance article written as a distinct product rather than a transcript.",
  "type": "object",
  "required": ["version", "article_tier", "title_candidates", "selected_title", "target_word_count", "actual_word_count", "lead", "body_markdown", "body_markdown_path", "sections", "key_takeaways", "claim_traceability", "visual_specs", "data_note", "disclaimer"],
  "properties": {
    "version": {"type": "string", "const": "1.0"},
    "article_tier": {"type": "string", "enum": ["A_core_research", "B_knowledge_extension", "C_experiment_log"]},
    "series_name": {"type": ["string", "null"]},
    "title_candidates": {"type": "array", "items": {"type": "string"}, "minItems": 3, "maxItems": 8},
    "selected_title": {"type": "string", "minLength": 6},
    "target_word_count": {"type": "integer", "minimum": 500, "maximum": 5000},
    "actual_word_count": {"type": "integer", "minimum": 300, "maximum": 8000},
    "lead": {"type": "string", "minLength": 20},
    "body_markdown": {"type": "string", "minLength": 300},
    "body_markdown_path": {"type": "string", "minLength": 1},
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "heading", "purpose", "evidence_refs"],
        "properties": {
          "id": {"type": "string"},
          "heading": {"type": "string"},
          "purpose": {"type": "string"},
          "evidence_refs": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      },
      "minItems": 4
    },
    "key_takeaways": {"type": "array", "items": {"type": "string"}, "minItems": 1, "maxItems": 3},
    "claim_traceability": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_ref", "section_id", "source_refs"],
        "properties": {
          "claim_ref": {"type": "string"},
          "section_id": {"type": "string"},
          "source_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1}
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "visual_specs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "role", "conclusion_title", "question_answered", "source_refs"],
        "properties": {
          "id": {"type": "string"},
          "role": {"type": "string", "enum": ["cover", "chart", "diagram", "source_screenshot"]},
          "conclusion_title": {"type": "string"},
          "question_answered": {"type": "string"},
          "source_refs": {"type": "array", "items": {"type": "string"}},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      },
      "minItems": 2,
      "maxItems": 6
    },
    "digest": {"type": "string", "maxLength": 240},
    "related_reading": {"type": "array", "items": {"type": "string"}, "maxItems": 3},
    "data_note": {"type": "string", "minLength": 10},
    "disclaimer": {"type": "string"},
    "metadata": {"type": "object"}
  },
  "additionalProperties": false
}
