{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/cover_package",
  "title": "Cover Package",
  "description": "Generated cover artwork and verification produced after the final video render.",
  "type": "object",
  "required": [
    "version",
    "status",
    "source_video_path",
    "primary_cover",
    "variants",
    "verification"
  ],
  "properties": {
    "version": { "type": "string", "enum": ["1.0", "1.1"] },
    "status": {
      "type": "string",
      "enum": ["ready", "needs_revision"]
    },
    "source_video_path": { "type": "string", "minLength": 1 },
    "primary_cover": { "$ref": "#/$defs/coverAsset" },
    "variants": {
      "type": "array",
      "items": { "$ref": "#/$defs/coverAsset" }
    },
    "creative_rationale": { "type": "string" },
    "decision_log_ref": { "type": "string" },
    "generation_policy": {
      "type": "string",
      "enum": [
        "codex_generated_visual_native_text",
        "user_approved_alternative",
        "non_codex_host"
      ]
    },
    "cover_approach": {
      "type": "string",
      "enum": ["generated_editorial", "composited", "frame_led"]
    },
    "visual_source": { "$ref": "#/$defs/visualSource" },
    "override": { "$ref": "#/$defs/override" },
    "verification": {
      "type": "object",
      "required": [
        "file_exists",
        "dimensions_match",
        "text_checked",
        "mobile_readability_checked",
        "content_match",
        "issues"
      ],
      "properties": {
        "file_exists": { "type": "boolean" },
        "dimensions_match": { "type": "boolean" },
        "text_checked": { "type": "boolean" },
        "mobile_readability_checked": { "type": "boolean" },
        "content_match": { "type": "boolean" },
        "issues": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "metadata": { "type": "object" }
  },
  "$defs": {
    "visualSource": {
      "type": "object",
      "required": ["kind", "source_tool", "provider", "path"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "codex_builtin_image_gen",
            "video_frame",
            "existing_asset",
            "external_image_provider",
            "local_composition"
          ]
        },
        "source_tool": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string" },
        "path": { "type": "string", "minLength": 1 },
        "prompt": { "type": "string" }
      },
      "additionalProperties": false
    },
    "override": {
      "type": "object",
      "required": ["user_approved", "reason"],
      "properties": {
        "user_approved": { "type": "boolean", "const": true },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "coverAsset": {
      "type": "object",
      "required": [
        "id",
        "path",
        "format",
        "width",
        "height",
        "aspect_ratio",
        "role",
        "text_overlay",
        "source_tool"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "format": { "type": "string", "enum": ["png", "jpg", "jpeg", "webp"] },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "aspect_ratio": { "type": "string", "pattern": "^[0-9]+:[0-9]+$" },
        "role": { "type": "string", "enum": ["primary", "variant"] },
        "text_overlay": {
          "type": "array",
          "items": { "type": "string" }
        },
        "source_tool": { "type": "string", "minLength": 1 },
        "provider": { "type": "string" },
        "model": { "type": "string" },
        "prompt": { "type": "string" },
        "style_reference_paths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "file_size_bytes": { "type": "integer", "minimum": 0 },
        "cost_usd": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "version": { "const": "1.1" } },
        "required": ["version"]
      },
      "then": {
        "required": ["generation_policy", "cover_approach", "visual_source"]
      }
    },
    {
      "if": {
        "properties": {
          "version": { "const": "1.1" },
          "generation_policy": { "const": "codex_generated_visual_native_text" }
        },
        "required": ["version", "generation_policy"]
      },
      "then": {
        "properties": {
          "visual_source": {
            "properties": {
              "kind": { "const": "codex_builtin_image_gen" }
            },
            "required": ["kind"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "version": { "const": "1.1" },
          "generation_policy": { "const": "user_approved_alternative" }
        },
        "required": ["version", "generation_policy"]
      },
      "then": { "required": ["override"] }
    }
  ],
  "additionalProperties": false
}
