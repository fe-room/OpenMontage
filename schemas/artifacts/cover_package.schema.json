{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/cover_package",
  "title": "Cover Package",
  "description": "Generated cover artwork and verification produced after the final video render.",
  "type": "object",
  "required": [
    "version",
    "status",
    "source_video_path",
    "primary_cover",
    "variants",
    "verification"
  ],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "status": {
      "type": "string",
      "enum": ["ready", "needs_revision"]
    },
    "source_video_path": { "type": "string", "minLength": 1 },
    "primary_cover": { "$ref": "#/$defs/coverAsset" },
    "variants": {
      "type": "array",
      "items": { "$ref": "#/$defs/coverAsset" }
    },
    "creative_rationale": { "type": "string" },
    "decision_log_ref": { "type": "string" },
    "verification": {
      "type": "object",
      "required": [
        "file_exists",
        "dimensions_match",
        "text_checked",
        "mobile_readability_checked",
        "content_match",
        "issues"
      ],
      "properties": {
        "file_exists": { "type": "boolean" },
        "dimensions_match": { "type": "boolean" },
        "text_checked": { "type": "boolean" },
        "mobile_readability_checked": { "type": "boolean" },
        "content_match": { "type": "boolean" },
        "issues": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "metadata": { "type": "object" }
  },
  "$defs": {
    "coverAsset": {
      "type": "object",
      "required": [
        "id",
        "path",
        "format",
        "width",
        "height",
        "aspect_ratio",
        "role",
        "text_overlay",
        "source_tool"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "format": { "type": "string", "enum": ["png", "jpg", "jpeg", "webp"] },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "aspect_ratio": { "type": "string", "pattern": "^[0-9]+:[0-9]+$" },
        "role": { "type": "string", "enum": ["primary", "variant"] },
        "text_overlay": {
          "type": "array",
          "items": { "type": "string" }
        },
        "source_tool": { "type": "string", "minLength": 1 },
        "provider": { "type": "string" },
        "model": { "type": "string" },
        "prompt": { "type": "string" },
        "style_reference_paths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "file_size_bytes": { "type": "integer", "minimum": 0 },
        "cost_usd": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
